#!/bin/zsh
# brick_creator - Create a brick!🧱 in the /bricks folder from a template folder
#
# Mason brick creator for the icodeforyou_flutter monorepo.

readonly VERSION='3.0.1-beta-1'

readonly TAGLINE='Create a brick!🧱 in the /bricks folder'

# Shows what this script is and does, then exits. Displays when "-a" or
# "--about" is the only parameter (optionally with -x).
show_about() {
    printf '%s' "${CYAN}"
    cat <<'EOF'
Mason brick creator for the icodeforyou_flutter monorepo.

Creates bricks/<name> from <source>/<name>. An existing brick of that name
is NEVER deleted: it is moved aside to bricks/<name>-old first (brick.yaml
included), because a generated brick is usually hand-edited afterwards
(extra mustache tags, conditionals, tweaked files) and that work must not
be silently lost. If bricks/<name>-old already exists the script stops
before touching anything; remove or rename it, then rerun.

Every source member is a directory, <source>/<name>, and the whole of it
becomes __brick__: a Dart package for packages and programs, a script kit
(script, README, LICENSE) for plumbing. brick.yaml is generated from
bricks/template/dart_brick.yaml for packages and programs, and from
bricks/template/plumbing_brick.yaml for plumbing. Every identity form in
the source is replaced with its mustache case lambda, the description (and
for plumbing, the positional contract) is templated, and the brick is
registered in the root mason.yaml if absent.

Whether the resulting brick is a widget or non-widget template is decided
entirely by the source package: point this at a source that has the
flutter dependency and test/golden scaffolding and you get a widget brick;
point it at one without and you don't.

Run from the monorepo root. Anything omitted is prompted for.

Examples:
  % brick_creator package_template --source=packages    # Dart package brick
  % brick_creator program_template --source=programs    # Dart program brick
  % brick_creator template_plumbing --source=plumbing   # zsh script brick
  % brick_creator                                       # prompts for both
  % brick_creator -h                                    # help (also --help)
  % brick_creator --about                               # this text (also -a)
EOF
    printf '%s\n' "${RESET}"
}

readonly SCRIPT_NAME="${0:t}"
readonly DEFAULT_BIN_DIR="$HOME/bin"
readonly LIB_DIR="${DEFAULT_BIN_DIR}/lib"

# Shared zsh libraries in LIB_DIR; every one must be present.
#   colors.zsh  - colors, error, info, success, color_print, version_print
#   common.zsh  - plain_output
readonly -a LIBS=('colors.zsh' 'common.zsh')

# Flags that must be the only parameter on the command line (apart from -x).
readonly -a SOLO_FLAGS=('-a' '--about' '-h' '--help')

# The one flag allowed alongside anything, including a solo flag.
readonly TRACE_FLAG='-x'

# The flag naming the monorepo subfolder the template lives in.
readonly SOURCE_FLAG='--source'

# Positional-argument contract: optional, because a missing template name is
# prompted for rather than rejected.
readonly POSITIONAL='optional'

# Display name of the positional argument in help and error text.
readonly POSITIONAL_NAME='<template_name>'

# Monorepo subfolders a brick may be built from.
readonly -a SOURCES=('packages' 'plumbing' 'programs')

# The one source whose members are zsh script kits, not Dart packages. The
# shape is the same (a directory); only the brick.yaml template and the
# description templating differ.
readonly PLUMBING_SOURCE='plumbing'

# brick.yaml templates; __name__ and __source__ are filled in.
readonly TEMPLATE_DIR='bricks/template'
readonly DART_BRICK_YAML="${TEMPLATE_DIR}/dart_brick.yaml"
readonly PLUMBING_BRICK_YAML="${TEMPLATE_DIR}/plumbing_brick.yaml"

# Reserved for bricks/template itself; can never be a brick name.
readonly RESERVED_NAME='template'

# Suffix appended to an existing brick when it is moved aside. A hyphen is
# deliberate: it can never collide with a snake_case brick name.
readonly OLD_SUFFIX='-old'

# Mustache tags. Held as values so the braces never pass through shell
# escaping (a backslash before a brace inside double quotes is RETAINED by
# zsh, not consumed).
readonly SNAKE_TAG='{{name.snakeCase()}}'
readonly CAMEL_TAG='{{name.camelCase()}}'
readonly PASCAL_TAG='{{name.pascalCase()}}'
readonly TITLE_TAG='{{name.titleCase()}}'
readonly DESCRIPTION_TAG='{{description}}'
readonly POSITIONAL_TAG='{{positional}}'
readonly POSITIONAL_NAME_TAG='{{positional_name}}'

# zsh strict mode:
#  -e (errexit) - exit immediately when any command returns non-zero
#  -u (nounset) - treat use of unset variables as an error
#  -o (pipefail) - a pipeline's exit status is the last non-zero status in the
#      pipe, not just the final command's
set -euo pipefail

# Help text with colors, displays when "-h" or "--help" is the only parameter
# (optionally with -x), and on any usage error.
#
# Every flag listed here must have a matching branch in main()'s case.
show_help() {
    cat <<EOF
${BOLD}USAGE${RESET}
    ${GREEN}${SCRIPT_NAME}${RESET} [${WHITE}${POSITIONAL_NAME}${RESET}] [${YELLOW}${SOURCE_FLAG}=${RESET}${WHITE}<source>${RESET}] [${YELLOW}-x${RESET}]
    ${GREEN}${SCRIPT_NAME}${RESET} ${YELLOW}-h${RESET}, ${YELLOW}--help${RESET} [${YELLOW}-x${RESET}]
    ${GREEN}${SCRIPT_NAME}${RESET} ${YELLOW}-a${RESET}, ${YELLOW}--about${RESET} [${YELLOW}-x${RESET}]

    ${POSITIONAL_NAME} is the only positional argument (${POSITIONAL}). Flags go in any order.
    -h/--help and -a/--about must be used alone; only -x may accompany them.

${BOLD}ARGUMENTS${RESET}
    ${WHITE}${POSITIONAL_NAME}${RESET}      snake_case name of the template member, which must exist as
                         the directory <source>/${POSITIONAL_NAME}. Prompted for when omitted.

${BOLD}FLAGS${RESET}
    ${YELLOW}${SOURCE_FLAG}=${RESET}${WHITE}<source>${RESET}    monorepo subfolder holding the template: one of
                         ${SOURCES[*]}. Prompted for when omitted.
    ${YELLOW}-x${RESET}                   turn on command tracing after the arguments are read
                         (may be combined with anything)
    ${YELLOW}-h${RESET}, ${YELLOW}--help${RESET}           show this help, then exit (no other parameters)
    ${YELLOW}-a${RESET}, ${YELLOW}--about${RESET}          show what this script is and does, then exit
                         (no other parameters)

${BOLD}WHAT IT DOES${RESET}
    Creates bricks/<name> from <source>/<name>:
    1. Moves an existing bricks/<name> aside to bricks/<name>${OLD_SUFFIX}
       (brick.yaml included). Nothing is ever deleted. Stops before
       touching anything if bricks/<name>${OLD_SUFFIX} already exists.
    2. Generates bricks/<name>/brick.yaml from the template for <source>:
         packages, programs -> ${DART_BRICK_YAML}
         plumbing           -> ${PLUMBING_BRICK_YAML}
    3. Registers the brick in the root mason.yaml if absent.
    4. Copies the whole source directory into __brick__ (excluding build
       junk and generated golden PNGs).
    5. Substitutes all identity forms with mustache case lambdas:
         snake_case, camelCase, PascalCase, Title Case
    6. Templates the description:
         packages, programs -> pubspec.yaml description
         plumbing           -> script header comment, TAGLINE, and the
                               POSITIONAL / POSITIONAL_NAME contract
    7. Renames every file and directory carrying an identity form to its
       mustache form.
    8. Verifies zero literal references remain in contents or file names;
       fails loudly if any do.

${BOLD}EXAMPLES${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} package_template ${SOURCE_FLAG}=packages   ${CYAN}# Dart package brick${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} program_template ${SOURCE_FLAG}=programs   ${CYAN}# Dart program brick${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} template_plumbing ${SOURCE_FLAG}=plumbing  ${CYAN}# zsh script brick${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET}                                      ${CYAN}# prompts for both${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} -h                                   ${CYAN}# this help${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} --about -x                           ${CYAN}# what this script is, traced${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} -a -h                                ${CYAN}# INVALID: solo flags cannot mix${RESET}

    Run from the monorepo root.

EOF
}

# --- shared libraries ------------------------------------------------------

# Sourced at top level, NOT inside a function: in zsh, `readonly NAME=value`
# inside a function declares a function-local variable, so a library sourced
# from a function would lose every color the moment the function returned.
# A missing library is fatal.
for _lib in "${LIBS[@]}"; do
    if [[ ! -r "${LIB_DIR}/${_lib}" ]]; then
        printf '%s: %s not found, cannot continue\n' "$SCRIPT_NAME" "${LIB_DIR}/${_lib}" >&2
        exit 1
    fi
    source "${LIB_DIR}/${_lib}"
done
unset _lib

# --- output ----------------------------------------------------------------

show_banner() {
    printf '\n'
    version_print "$SCRIPT_NAME" "$VERSION" "$TAGLINE"
    printf '\n'
}

error_exit() {
    printf '\n'
    error "$1" >&2
    printf '\n'
    exit 1
}

# Any bad input: report it, show help, exit 1.
usage_exit() {
    printf '\n'
    error "$1" >&2
    printf '\n'
    show_help >&2
    exit 1
}

# --- xtrace record / reset -------------------------------------------------
# -x records the current trace state, turns tracing on for the run of the
# script, and at exit resets it to what the parent shell had.
#
# zsh restores the XTRACE option when the function that set it returns, so
# `set -x` must run in the body of the function being traced (main(),
# handle_about()), never in a helper.
XTRACE_WAS_ON=false

xtrace_is_on() {
    [[ -o xtrace ]]
}

record_xtrace() {
    if xtrace_is_on; then
        XTRACE_WAS_ON=true
    fi
}

reset_xtrace() {
    if [[ "$XTRACE_WAS_ON" == false ]] && xtrace_is_on; then
        set +x
        info 'tracing is off'
    fi
}

trap reset_xtrace EXIT

# --- state -----------------------------------------------------------------
# Filled by argument parsing (or prompting).

# true when -x was given; tracing is enabled once the arguments are read.
trace_requested=false

# The template name in snake_case, e.g. widget_template.
template_name=''

# The monorepo subfolder holding the template, one of SOURCES.
source_dir=''

# Identity forms, derived from template_name once validated.
snake=''
camel=''
pascal=''
title=''

# Paths, derived from template_name and source_dir once validated.
source_path=''
brick_home=''
brick_old=''
brick_dir=''
brick_yaml_template=''

# --- argument rules --------------------------------------------------------

# Returns 0 when $1 is one of SOLO_FLAGS.
is_solo_flag() {
    (( ${SOLO_FLAGS[(Ie)$1]} ))
}

# Returns 0 when $1 is the trace flag.
is_trace_flag() {
    [[ "$1" == "$TRACE_FLAG" ]]
}

# Returns 0 when any of the given arguments is the trace flag.
trace_requested_in() {
    (( ${@[(Ie)$TRACE_FLAG]} ))
}

# Enforces the solo-flag rule over the full command line:
#   - at most one of SOLO_FLAGS may appear
#   - when one appears, nothing else may, except TRACE_FLAG
# Any violation is a usage error.
enforce_solo_flags() {
    local arg
    local solo=''
    local -a others=()

    for arg in "$@"; do
        if is_trace_flag "$arg"; then
            continue
        fi
        if is_solo_flag "$arg"; then
            if [[ -n "$solo" ]]; then
                usage_exit "${solo} and ${arg} cannot be combined"
            fi
            solo="$arg"
        else
            others+=("$arg")
        fi
    done

    if [[ -n "$solo" ]] && (( ${#others[@]} > 0 )); then
        usage_exit "${solo} must be the only parameter (apart from ${TRACE_FLAG}), got: ${others[*]}"
    fi
}

# -a / --about is handled before the banner so the output is just the about
# text. enforce_solo_flags() has already guaranteed nothing else is present
# except possibly -x, which is honoured.
handle_about() {
    if (( ${@[(Ie)--about]} || ${@[(Ie)-a]} )); then
        if trace_requested_in "$@" && ! xtrace_is_on; then
            info 'tracing is on'
            set -x
        fi
        show_about
        exit 0
    fi
}

# Accepts one positional argument per the POSITIONAL contract. Sets template_name.
accept_positional() {
    local arg="$1"
    if [[ "$POSITIONAL" == 'none' ]]; then
        usage_exit "${SCRIPT_NAME} takes no positional argument, got: ${arg}"
    fi
    if [[ -n "$template_name" ]]; then
        usage_exit "one ${POSITIONAL_NAME} at a time, got ${template_name} and ${arg}"
    fi
    template_name="$arg"
}

# Accepts --source=<value>. Sets source_dir.
accept_source() {
    local arg="$1"
    if [[ -n "$source_dir" ]]; then
        usage_exit "one ${SOURCE_FLAG} at a time, got ${source_dir} and ${arg#*=}"
    fi
    source_dir="${arg#*=}"
}

# --- prompting -------------------------------------------------------------

# Asks for the template name when none was given on the command line.
prompt_template_name() {
    if [[ -n "$template_name" ]]; then
        return 0
    fi
    read -r "template_name?${POSITIONAL_NAME} (snake_case): "
}

# Asks for the source when none was given on the command line.
prompt_source() {
    if [[ -n "$source_dir" ]]; then
        return 0
    fi
    read -r "source_dir?source (${(j:|:)SOURCES}): "
}

# --- validation ------------------------------------------------------------

validate_template_name() {
    if [[ -z "$template_name" ]]; then
        usage_exit "${POSITIONAL_NAME} is required"
    fi
    if [[ ! "$template_name" =~ '^[a-z][a-z0-9_]*$' ]]; then
        usage_exit "${POSITIONAL_NAME} must be snake_case, got: ${template_name}"
    fi
    if [[ "$template_name" == "$RESERVED_NAME" ]]; then
        usage_exit "'${RESERVED_NAME}' is reserved for ${TEMPLATE_DIR} and cannot be a brick name"
    fi
}

validate_source() {
    if [[ -z "$source_dir" ]]; then
        usage_exit "${SOURCE_FLAG} is required"
    fi
    if ! (( ${SOURCES[(Ie)$source_dir]} )); then
        usage_exit "${SOURCE_FLAG} must be one of ${SOURCES[*]}, got: ${source_dir}"
    fi
}

verify_monorepo_root() {
    if [[ ! -f 'pubspec.yaml' || ! -d 'bricks' ]]; then
        error_exit 'Run from the monorepo root (pubspec.yaml + bricks/ required).'
    fi
}

# Every source member, whatever its kind, is a directory at <source>/<name>.
verify_inputs_exist() {
    if [[ ! -f "$brick_yaml_template" ]]; then
        error_exit "brick.yaml template not found: ${brick_yaml_template}"
    fi
    if [[ ! -d "$source_dir" ]]; then
        error_exit "Source subfolder not found: /${source_dir}"
    fi
    if [[ ! -d "$source_path" ]]; then
        error_exit "Template directory not found: ${source_path}"
    fi
}

# An existing brick is moved aside, never deleted; the slot it moves into
# must be free. Checked before anything is written so a refusal leaves the
# repo exactly as it was.
verify_old_brick_slot_free() {
    if [[ -d "$brick_home" && -e "$brick_old" ]]; then
        error_exit "${brick_old} already exists; remove or rename it before ${brick_home} can be moved aside."
    fi
}

# --- derivation ------------------------------------------------------------

# Returns 0 when the source is plumbing (zsh script kits, no pubspec.yaml).
is_plumbing() {
    [[ "$source_dir" == "$PLUMBING_SOURCE" ]]
}

# Prints the brick.yaml template for the current source.
brick_yaml_template_for_source() {
    if is_plumbing; then
        printf '%s' "$PLUMBING_BRICK_YAML"
    else
        printf '%s' "$DART_BRICK_YAML"
    fi
}

# snake_case -> Title Case -> PascalCase -> camelCase.
derive_identity_forms() {
    snake="$template_name"
    title="${(C)${snake//_/ }}"
    pascal="${title// /}"
    camel="${pascal[1]:l}${pascal[2,-1]}"
}

derive_paths() {
    source_path="${source_dir}/${snake}"
    brick_home="bricks/${snake}"
    brick_old="${brick_home}${OLD_SUFFIX}"
    brick_dir="${brick_home}/__brick__"
    brick_yaml_template="$(brick_yaml_template_for_source)"
}

# --- 1. preserve existing brick --------------------------------------------

# Moves bricks/<name> aside to bricks/<name>-old rather than deleting it. A
# brick is hand-edited after generation (extra mustache tags, conditionals,
# tweaked files); regenerating from source is lossy, so the previous brick
# must survive for the edits to be carried over. verify_old_brick_slot_free()
# has already guaranteed the destination is free.
preserve_existing_brick() {
    if [[ -d "$brick_home" ]]; then
        mv "$brick_home" "$brick_old"
        plain_output 'Existing brick' "moved to ${brick_old}"
    fi
    mkdir -p "$brick_dir"
}

# --- 2. generate brick.yaml ------------------------------------------------

generate_brick_yaml() {
    sed \
        -e "s|__name__|${snake}|g" \
        -e "s|__source__|${source_path}|g" \
        "$brick_yaml_template" > "${brick_home}/brick.yaml"
    plain_output 'brick.yaml' "generated from ${brick_yaml_template}"
}

# --- 3. register in root mason.yaml ----------------------------------------

register_in_mason_yaml() {
    if [[ ! -f 'mason.yaml' ]]; then
        cat > 'mason.yaml' <<EOF
bricks:
  ${snake}:
    path: bricks/${snake}
EOF
        plain_output 'mason.yaml' 'created with entry'
    elif grep -q "^  ${snake}:$" 'mason.yaml'; then
        plain_output 'mason.yaml' 'entry exists (untouched)'
    else
        cat >> 'mason.yaml' <<EOF
  ${snake}:
    path: bricks/${snake}
EOF
        plain_output 'mason.yaml' 'entry appended'
    fi
}

# --- 4. copy source --------------------------------------------------------

# The whole member directory, modes preserved so scripts stay executable.
# Build junk and generated golden PNGs are excluded: the PNGs carry the
# template's rendering, not the new package's, and are regenerated with
# `melos goldens`. The excludes are simply absent from a plumbing kit.
copy_source() {
    rsync -a \
        --exclude='.dart_tool/' \
        --exclude='.idea/' \
        --exclude='.gradle/' \
        --exclude='build/' \
        --exclude='coverage/' \
        --exclude='ephemeral/' \
        --exclude='Pods/' \
        --exclude='.symlinks/' \
        --exclude='xcuserdata/' \
        --exclude='.DS_Store' \
        --exclude='*.iml' \
        --exclude='.flutter-plugins-dependencies' \
        --exclude='local.properties' \
        --exclude='ios/Flutter/Generated.xcconfig' \
        --exclude='ios/Flutter/flutter_export_environment.sh' \
        --exclude='test/golden/goldens/*.png' \
        --exclude='test/golden/failures/' \
        "${source_path}/" "${brick_dir}/"
    plain_output 'Template copied' "${source_path} -> ${brick_dir}"
}

# --- 5. substitute identity forms ------------------------------------------

# Prints every text file under the brick that mentions any identity form.
files_with_identity_forms() {
    grep -rlIE "${snake}|${camel}|${pascal}|${title}" "$brick_dir" || true
}

# Title Case first (it contains a space, so it never collides), then
# snake_case before camelCase so single-word names (where the two forms are
# identical) resolve to snakeCase(), matching Dart file-naming convention.
substitute_identity_forms() {
    local file
    local -a files=("${(@f)$(files_with_identity_forms)}")

    for file in "${files[@]}"; do
        [[ -n "$file" ]] || continue
        sed -i '' \
            -e "s/${title}/${TITLE_TAG}/g" \
            -e "s/${snake}/${SNAKE_TAG}/g" \
            -e "s/${camel}/${CAMEL_TAG}/g" \
            -e "s/${pascal}/${PASCAL_TAG}/g" \
            "$file"
    done
    plain_output 'Substitutions' "${snake} ${camel} ${pascal} '${title}'"
}

# --- 6. template the description -------------------------------------------

template_description() {
    if is_plumbing; then
        template_plumbing_script
    else
        template_pubspec_description
    fi
}

# Dart package / program: the pubspec.yaml description.
template_pubspec_description() {
    local pubspec="${brick_dir}/pubspec.yaml"
    if [[ ! -f "$pubspec" ]]; then
        error_exit "No pubspec.yaml in ${source_path}"
    fi
    sed -i '' "s/^description: .*/description: \"${DESCRIPTION_TAG}\"/" "$pubspec"
    plain_output 'pubspec.yaml' "description -> ${DESCRIPTION_TAG}"
}

# Plumbing kit: the script's header comment, TAGLINE, and positional contract.
# The script is the kit file named after the member. Runs after identity
# substitution, so the header already carries SNAKE_TAG and the file is still
# named after the source (renamed in step 7).
template_plumbing_script() {
    local script="${brick_dir}/${snake}"
    if [[ ! -f "$script" ]]; then
        error_exit "Script missing from brick: ${script}"
    fi
    sed -i '' \
        -e "s/^# ${SNAKE_TAG} - .*/# ${SNAKE_TAG} - ${DESCRIPTION_TAG}/" \
        -e "s/^readonly TAGLINE=.*/readonly TAGLINE='${DESCRIPTION_TAG}'/" \
        -e "s/^readonly POSITIONAL=.*/readonly POSITIONAL='${POSITIONAL_TAG}'/" \
        -e "s/^readonly POSITIONAL_NAME=.*/readonly POSITIONAL_NAME='${POSITIONAL_NAME_TAG}'/" \
        "$script"
    plain_output "${snake}" "header, TAGLINE -> ${DESCRIPTION_TAG}; POSITIONAL -> ${POSITIONAL_TAG}, ${POSITIONAL_NAME_TAG}"
}

# --- 7. rename template-named files and directories ------------------------

# Prints every path under the brick whose name carries an identity form,
# depth-first so children are renamed before their parent directories.
paths_with_identity_forms() {
    find "$brick_dir" -depth \( -name "*${snake}*" -o -name "*${pascal}*" -o -name "*${camel}*" \)
}

# snake_case is replaced before camelCase so single-word template names
# (where the two forms are identical) resolve to snakeCase().
# NOTE: never `local path` in zsh — `path` is the array bound to PATH, and
# localising it empties PATH for this function and everything it calls.
rename_template_paths() {
    local entry dir base newbase
    local -a entries=("${(@f)$(paths_with_identity_forms)}")

    for entry in "${entries[@]}"; do
        [[ -n "$entry" ]] || continue
        dir="${entry:h}"
        base="${entry:t}"
        newbase="${base//${pascal}/${PASCAL_TAG}}"
        newbase="${newbase//${snake}/${SNAKE_TAG}}"
        newbase="${newbase//${camel}/${CAMEL_TAG}}"
        if [[ "$newbase" != "$base" ]]; then
            mv "$entry" "${dir}/${newbase}"
            plain_output 'Renamed' "${base} -> ${newbase}"
        fi
    done
}

# --- 8. verify -------------------------------------------------------------

verify_brick_clean() {
    if grep -rIE "${snake}|${camel}|${pascal}|${title}" "$brick_dir"; then
        error_exit 'Literal references remain in file contents (listed above). Brick is dirty.'
    fi
    if find "$brick_dir" \( -name "*${snake}*" -o -name "*${pascal}*" -o -name "*${camel}*" -o -name '*\\*' \) | grep .; then
        error_exit 'Literal or malformed references remain in file names (listed above). Brick is dirty.'
    fi
    success "Brick created clean: ${brick_home}"
}

# --- next steps ------------------------------------------------------------

show_next_steps() {
    printf '\n'
    if [[ -d "$brick_old" ]]; then
        color_print "${WHITE}" "Previous brick preserved at ${YELLOW}${brick_old}${WHITE}: diff it against ${brick_home},"
        color_print "${WHITE}" 'carry over any hand-made edits, then delete it.'
        printf '\n'
    fi
    color_print "${WHITE}" "Create a NEW ${source_dir} member from this brick (from the monorepo root):"
    printf '\n'
    printf "  mason_make ${GREEN}my_%s${RESET} -using=%s -dir=${YELLOW}%s${RESET}\n" "$snake" "$snake" "$source_dir"
    printf '\n'
    if is_plumbing; then
        return 0
    fi
    printf "  Then add ${YELLOW}%s/my_%s${RESET} to the workspace list in the root ${YELLOW}pubspec.yaml${RESET}\n" "$source_dir" "$snake"
    printf "  and run: ${YELLOW}melos bootstrap${RESET}\n"
}

# --- main ------------------------------------------------------------------

main() {
    record_xtrace

    enforce_solo_flags "$@"
    handle_about "$@"

    show_banner

    local arg
    for arg in "$@"; do
        case "$arg" in
            -h|--help)
                show_help
                exit 0
                ;;
            -a|--about)
                show_about
                exit 0
                ;;
            -x)
                trace_requested=true
                ;;
            ${SOURCE_FLAG}=*)
                accept_source "$arg"
                ;;
            ${SOURCE_FLAG})
                usage_exit "${SOURCE_FLAG} needs a value: ${SOURCE_FLAG}=<${(j:|:)SOURCES}>"
                ;;
            -*)
                usage_exit "unknown option ${arg}"
                ;;
            *)
                accept_positional "$arg"
                ;;
        esac
    done

    if [[ "$trace_requested" == true ]] && ! xtrace_is_on; then
        info 'tracing is on'
        set -x
    fi

    prompt_template_name
    prompt_source
    validate_template_name
    validate_source

    derive_identity_forms
    derive_paths

    verify_monorepo_root
    verify_inputs_exist
    verify_old_brick_slot_free

    preserve_existing_brick
