#!/usr/bin/env zsh
# melos_tool/melos_header_fix
# First-line path header fixer for the icodeforyou_flutter monorepo.
# Version: 1.0.0
#
# Usage:
#   melos_header_fix           — dry run: report what would change
#   melos_header_fix --write    — apply the changes
#
# Must be run from the workspace root.
# Exit status: 0 success, 64 wrong directory or bad argument.
#
# For every hand-written .dart file under lib/ or test/ in packages |
# plugins | programs:
#
#   * If line 1 is a path-shaped comment (`// something/….dart`) that does
#     not match the file's real repo-relative path, it is REPLACED with the
#     truthful header.
#   * If the file has no path header at all, one is INSERTED as line 1,
#     followed by a blank line.
#   * Files whose header is already truthful are left untouched.
#
# Generated files (*.g.dart, *.freezed.dart, *.mocks.dart, *.drift.dart,
# *.gr.dart, *.config.dart) are never touched.
#
# IMPORTANT: fix filename bugs BEFORE running with --write. This tool makes
# headers agree with paths; if the path itself is wrong (typo'd filename,
# doubled extension), fixing the header first buries that signal. Run
# melos_audit.zsh, resolve the anomalies it exposes, then run this.

set -uo pipefail

readonly MODE="${1:-}"
readonly TIERS=(packages plugins programs)

readonly -a GENERATED_NAME_FILTERS=(
  -not -name '*.g.dart'
  -not -name '*.freezed.dart'
  -not -name '*.mocks.dart'
  -not -name '*.drift.dart'
  -not -name '*.gr.dart'
  -not -name '*.config.dart'
)

readonly -a PATH_FILTERS=(
  -not -path '*/.dart_tool/*'
  -not -path '*/build/*'
)

# ─── preconditions ──────────────────────────────────────────────────────────

if [[ ! -f pubspec.yaml ]] || ! grep -q '^name: icodeforyou_flutter' pubspec.yaml; then
  print -u2 "❌ Run this from the icodeforyou_flutter workspace root."
  exit 64
fi

case "$MODE" in
  ""|--write) ;;
  *)
    print -u2 "Usage: $0 [--write]"
    print -u2 "  no argument: dry run (report only)"
    print -u2 "  --write:     apply header fixes"
    exit 64
    ;;
esac

readonly WRITE=$([[ "$MODE" == "--write" ]] && print "true" || print "false")

typeset -i replaced=0
typeset -i inserted=0
typeset -i untouched=0

# ─── fixers ─────────────────────────────────────────────────────────────────

replace_header() {
  local f="$1"
  local tmp="${f}.header_tmp"
  { print -- "// $f"; tail -n +2 "$f"; } > "$tmp" && mv "$tmp" "$f"
}

insert_header() {
  local f="$1"
  local tmp="${f}.header_tmp"
  { print -- "// $f"; print ""; cat "$f"; } > "$tmp" && mv "$tmp" "$f"
}

# ─── run ────────────────────────────────────────────────────────────────────

if [[ "$WRITE" == "true" ]]; then
  print "🛠️  Fixing first-line path headers (writing changes)..."
else
  print "🔍 Dry run — no files will be modified. Use --write to apply."
fi

while IFS= read -r f; do
  first_line=$(head -n 1 "$f")

  if [[ "$first_line" == '// '* && "${first_line#// }" == */*.dart ]]; then
    claimed="${first_line#// }"
    if [[ "$claimed" == "$f" ]]; then
      untouched=$((untouched + 1))
      continue
    fi
    if [[ "$WRITE" == "true" ]]; then
      replace_header "$f"
      print "  ✏️  replaced: $f"
    else
      print "  ✏️  would replace: $f"
      print "      was: $claimed"
    fi
    replaced=$((replaced + 1))
  else
    if [[ "$WRITE" == "true" ]]; then
      insert_header "$f"
      print "  ➕ inserted: $f"
    else
      print "  ➕ would insert: $f"
    fi
    inserted=$((inserted + 1))
  fi
done < <(find $TIERS -type f -name '*.dart' \
  \( -path '*/lib/*' -o -path '*/test/*' \) \
  $PATH_FILTERS $GENERATED_NAME_FILTERS 2>/dev/null)

# ─── summary ────────────────────────────────────────────────────────────────

print ""
print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [[ "$WRITE" == "true" ]]; then
  print "📊 HEADER FIX SUMMARY (applied)"
else
  print "📊 HEADER FIX SUMMARY (dry run)"
fi
print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
print "Replaced:  ${replaced}"
print "Inserted:  ${inserted}"
print "Untouched: ${untouched}"
print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [[ "$WRITE" != "true" && $((replaced + inserted)) -gt 0 ]]; then
  print "Run again with --write to apply, then re-run melos_audit.zsh to verify."
fi
exit 0