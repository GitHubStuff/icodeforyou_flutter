#!/bin/zsh
# mason_make - Mason brick consumer for the icodeforyou_flutter monorepo

readonly VERSION='0.2.0-beta'

readonly TAGLINE='creating monorepo members from Mason bricks'

# Shows what this script is and does, then exits. Displays when "-a" or
# "--about" is the only parameter (optionally with -x).
show_about() {
    printf '%s' "${CYAN}"
    cat <<'EOF'
mason_make creates a new member (folder + code) of the icodeforyou_flutter
monorepo (a package, plugin, program, or plumbing script) from a Mason brick
in /bricks off the root of the repo.

The command line says what to make, which brick to use, and where it goes:

  mason_make <name> --using=<brick> --dir=<subfolder>

It wraps `mason make` with monorepo-aware validation: it verifies every
brick registered in mason.yaml still exists under /bricks (a stale entry
breaks mason make for all bricks), verifies the requested brick is both
registered and present, verifies the output subfolder is one of the allowed
monorepo content directories, and verifies the output folder does not
already exist. It reads the brick's variables from brick.yaml and passes
the ones it knows: `name` gets <name>, `folder_source` gets <subfolder>.
Mason prompts for any other variables the brick declares, per brick.yaml.
It runs `mason get`, then generates the new member at <subfolder>/<name>.
When done it prints the path to the new member and puts a ready-to-paste
`cd` command in the clipboard.

Run from the monorepo root. Requires mason on PATH.

Examples:
  % mason_make sincewhen_models --using=template_dart --dir=packages
  % mason_make git_me --using=template_plumbing --dir=plumbing
  % mason_make -h                          # help (also --help)
  % mason_make --about                     # this text (also -a)
EOF
    printf '%s\n' "${RESET}"
}

readonly SCRIPT_NAME="${0:t}"
readonly DEFAULT_BIN_DIR="$HOME/bin"
readonly COLORS_LIB="${DEFAULT_BIN_DIR}/lib/colors.zsh"

# Flags that must be the only parameter on the command line (apart from -x).
readonly -a SOLO_FLAGS=('-a' '--about' '-h' '--help')

# The one flag allowed alongside anything, including a solo flag.
readonly TRACE_FLAG='-x'

# Long options that take a value, written as --<option>=<value>.
readonly USING_OPTION='--using'
readonly DIR_OPTION='--dir'

# Brick variables the script fills from its own arguments, when the brick
# declares them. Mason prompts for every other variable the brick declares.
readonly NAME_VAR='name'            # <- <name>
readonly FOLDER_VAR='folder_source' # <- --dir

# Positional-argument contract. Exactly one of:
#   none     - the script takes no positional argument; giving one is an error
#   optional - the script may take one positional argument
#   required - the script must be given one positional argument
readonly POSITIONAL='required'

# Display name of the positional argument in help and error text.
readonly POSITIONAL_NAME='<name>'

# Monorepo subfolders that may receive a new member. Add new content
# directories here as the monorepo grows.
readonly -a ALLOWED_DIRS=('packages' 'plugins' 'programs' 'plumbing')

# Files and folders that must exist at the monorepo root.
readonly ROOT_PUBSPEC='pubspec.yaml'
readonly ROOT_MASON='mason.yaml'
readonly BRICKS_DIR='bricks'

# Every brick's metadata file.
readonly BRICK_YAML='brick.yaml'

# zsh strict mode:
#  -e (errexit) - exit immediately when any command returns non-zero
#  -u (nounset) - treat use of unset variables as an error (typo catcher)
#  -o (pipefail) - pipeline's exit status is the last non-zero status in the pipe,
#      not just the final command's
set -euo pipefail

# Help text with colors, displays when "-h" or "--help" is the only parameter
# (optionally with -x), and on any usage error.
#
# Every option listed here must have a matching branch in main()'s case.
show_help() {
    cat <<EOF
${BOLD}USAGE${RESET}
    ${GREEN}${SCRIPT_NAME}${RESET} ${WHITE}${POSITIONAL_NAME}${RESET} ${YELLOW}${USING_OPTION}=${RESET}${WHITE}<brick>${RESET} ${YELLOW}${DIR_OPTION}=${RESET}${WHITE}<subfolder>${RESET} [${YELLOW}-x${RESET}]
    ${GREEN}${SCRIPT_NAME}${RESET} ${YELLOW}-h${RESET}, ${YELLOW}--help${RESET} [${YELLOW}-x${RESET}]
    ${GREEN}${SCRIPT_NAME}${RESET} ${YELLOW}-a${RESET}, ${YELLOW}--about${RESET} [${YELLOW}-x${RESET}]

    ${POSITIONAL_NAME} is the only positional argument (${POSITIONAL}). Options go in any order.
    -h/--help and -a/--about must be used alone; only -x may accompany them.

${BOLD}ARGUMENTS${RESET}
    ${WHITE}${POSITIONAL_NAME}${RESET}                 new member name in snake_case; becomes the output
                           folder name under <subfolder> AND the brick's
                           '${NAME_VAR}' variable

${BOLD}OPTIONS${RESET}
    ${YELLOW}${USING_OPTION}=${RESET}${WHITE}<brick>${RESET}        brick to consume (required); must be registered in the
                           root ${ROOT_MASON} AND exist as a folder under /${BRICKS_DIR}
    ${YELLOW}${DIR_OPTION}=${RESET}${WHITE}<subfolder>${RESET}      monorepo subfolder receiving the new member (required);
                           also the brick's '${FOLDER_VAR}' variable when declared
                           allowed: ${GREEN}${(j:, :)ALLOWED_DIRS}${RESET}
    ${YELLOW}-x${RESET}                     turn on command tracing after the arguments are read
                           (may be combined with anything)
    ${YELLOW}-h${RESET}, ${YELLOW}--help${RESET}             show this help, then exit (no other parameters)
    ${YELLOW}-a${RESET}, ${YELLOW}--about${RESET}            show what this script is and does, then exit
                           (no other parameters)

${BOLD}WHAT IT DOES${RESET}
    1. Verifies it is running from the monorepo root
       (${ROOT_PUBSPEC}, ${ROOT_MASON} and /${BRICKS_DIR} required).
    2. Verifies <subfolder> is allowed and exists.
    3. Verifies every path brick registered in ${ROOT_MASON} exists under
       /${BRICKS_DIR} (one stale entry breaks mason make for all bricks).
    4. Verifies the requested brick is registered in ${ROOT_MASON} AND present
       under /${BRICKS_DIR} (guards deletions and typos).
    5. Verifies <subfolder>/${POSITIONAL_NAME} does not already exist.
    6. Reads the brick's ${BRICK_YAML} and passes the variables it knows:
       '${NAME_VAR}' <- ${POSITIONAL_NAME}, '${FOLDER_VAR}' <- <subfolder>. Mason prompts
       for the rest, per ${BRICK_YAML}.
    7. Runs mason get.
    8. Runs: mason make <brick> --${NAME_VAR} ${POSITIONAL_NAME} [--${FOLDER_VAR} <subfolder>]
             -o <subfolder>/${POSITIONAL_NAME}
    9. Prints the full path to the new member and puts a ready-to-paste
       'cd <path>' command in the clipboard (pbcopy).

${BOLD}EXAMPLES${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} sincewhen_models --using=template_dart --dir=packages   ${CYAN}# new package${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} cooool_stuff --using=template_dart --dir=programs       ${CYAN}# new program${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} git_me --using=template_plumbing --dir=plumbing -x       ${CYAN}# new plumbing script, traced${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} -h                                                      ${CYAN}# this help${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} --about -x                                              ${CYAN}# what this script is, traced${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} -a -h                                                   ${CYAN}# INVALID: solo flags cannot mix${RESET}

EOF
}

# verify color library
if [[ ! -r "$COLORS_LIB" ]]; then
    printf '%s: %s not found, cannot continue\n' "$SCRIPT_NAME" "$COLORS_LIB" >&2
    exit 1
fi
# reads the file and executes its contents in the current shell, rather than
# in a child process, so every function, variable, alias, and setopt defined
# in colors.zsh becomes available in this script's own scope.
source "$COLORS_LIB"

# --- output ----------------------------------------------------------------

show_banner() {
    printf '\n'
    version_print "$SCRIPT_NAME" "$VERSION" "$TAGLINE"
    printf '\n'
}

error_exit() {
    printf '\n'
    error "$1" >&2
    printf '\n'
    exit 1
}

# Any bad input: report it, show help, exit 1.
usage_exit() {
    printf '\n'
    error "$1" >&2
    printf '\n'
    show_help >&2
    exit 1
}

# --- xtrace record / reset -------------------------------------------------
# -x records the current trace state, turns tracing on for the run of the
# script, and at exit resets it to what the parent shell had.
#
# zsh restores the XTRACE option when the function that set it returns, so
# `set -x` must run in the body of the function being traced (main(),
# handle_about()), never in a helper.
XTRACE_WAS_ON=false

xtrace_is_on() {
    [[ -o xtrace ]]
}

record_xtrace() {
    if xtrace_is_on; then
        XTRACE_WAS_ON=true
    fi
}

reset_xtrace() {
    if [[ "$XTRACE_WAS_ON" == false ]] && xtrace_is_on; then
        set +x
        info 'tracing is off'
    fi
}

trap reset_xtrace EXIT

# --- state -----------------------------------------------------------------
# Filled by argument parsing and validation.

# true when -x was given; tracing is enabled once the arguments are read.
trace_requested=false

# The positional argument: the new member name in snake_case.
member_name=''

# Brick to consume, from --using=<brick>.
brick=''

# Monorepo subfolder receiving the new member, from --dir=<subfolder>.
target_dir=''

# The brick's declared variables, in declaration order, from its brick.yaml.
typeset -a brick_vars=()

# --- argument rules --------------------------------------------------------

# Returns 0 when $1 is one of SOLO_FLAGS.
is_solo_flag() {
    (( ${SOLO_FLAGS[(Ie)$1]} ))
}

# Returns 0 when $1 is the trace flag.
is_trace_flag() {
    [[ "$1" == "$TRACE_FLAG" ]]
}

# Returns 0 when any of the given arguments is the trace flag.
trace_requested_in() {
    (( ${@[(Ie)$TRACE_FLAG]} ))
}

# Enforces the solo-flag rule over the full command line:
#   - at most one of SOLO_FLAGS may appear
#   - when one appears, nothing else may, except TRACE_FLAG
# Any violation is a usage error.
enforce_solo_flags() {
    local arg
    local solo=''
    local -a others=()

    for arg in "$@"; do
        if is_trace_flag "$arg"; then
            continue
        fi
        if is_solo_flag "$arg"; then
            if [[ -n "$solo" ]]; then
                usage_exit "${solo} and ${arg} cannot be combined"
            fi
            solo="$arg"
        else
            others+=("$arg")
        fi
    done

    if [[ -n "$solo" ]] && (( ${#others[@]} > 0 )); then
        usage_exit "${solo} must be the only parameter (apart from ${TRACE_FLAG}), got: ${others[*]}"
    fi
}

# -a / --about is handled before the banner so the output is just the about
# text. enforce_solo_flags() has already guaranteed nothing else is present
# except possibly -x, which is honoured.
handle_about() {
    if (( ${@[(Ie)--about]} || ${@[(Ie)-a]} )); then
        if trace_requested_in "$@" && ! xtrace_is_on; then
            info 'tracing is on'
            set -x
        fi
        show_about
        exit 0
    fi
}

# Accepts one positional argument per the POSITIONAL contract. Sets member_name.
accept_positional() {
    local arg="$1"
    if [[ "$POSITIONAL" == 'none' ]]; then
        usage_exit "${SCRIPT_NAME} takes no positional argument, got: ${arg}"
    fi
    if [[ -n "$member_name" ]]; then
        usage_exit "one ${POSITIONAL_NAME} at a time, got ${member_name} and ${arg}"
    fi
    member_name="$arg"
}

# After parsing: fails when the contract is 'required' and none was given.
require_positional() {
    if [[ "$POSITIONAL" == 'required' && -z "$member_name" ]]; then
        usage_exit "${POSITIONAL_NAME} is required"
    fi
}

# Accepts --using=<brick>. Sets brick.
accept_brick() {
    local value="$1"
    if [[ -z "$value" ]]; then
        usage_exit "${USING_OPTION} requires a brick name (e.g. ${USING_OPTION}=template_dart)"
    fi
    if [[ -n "$brick" ]]; then
        usage_exit "one ${USING_OPTION} at a time, got ${brick} and ${value}"
    fi
    brick="$value"
}

# Accepts --dir=<subfolder>. Sets target_dir.
accept_dir() {
    local value="$1"
    if [[ -z "$value" ]]; then
        usage_exit "${DIR_OPTION} requires a subfolder (allowed: ${(j:, :)ALLOWED_DIRS})"
    fi
    if [[ -n "$target_dir" ]]; then
        usage_exit "one ${DIR_OPTION} at a time, got ${target_dir} and ${value}"
    fi
    target_dir="$value"
}

# After parsing: fails when any required option is missing.
require_options() {
    if [[ -z "$brick" ]]; then
        usage_exit "missing required ${USING_OPTION}=<brick>"
    fi
    if [[ -z "$target_dir" ]]; then
        usage_exit "missing required ${DIR_OPTION}=<subfolder> (allowed: ${(j:, :)ALLOWED_DIRS})"
    fi
}

# --- paths -----------------------------------------------------------------

# Relative path of the new member from the monorepo root.
target_path() {
    printf '%s/%s' "$target_dir" "$member_name"
}

# Relative path of the requested brick's folder.
brick_dir() {
    printf '%s/%s' "$BRICKS_DIR" "$brick"
}

# Relative path of the requested brick's brick.yaml.
brick_yaml() {
    printf '%s/%s' "$(brick_dir)" "$BRICK_YAML"
}

# --- validation ------------------------------------------------------------

# The new member name must be snake_case: it becomes the output folder and
# the brick's name variable, which the bricks use as a Dart identifier.
validate_member_name() {
    if [[ ! "$member_name" =~ '^[a-z][a-z0-9_]*$' ]]; then
        usage_exit "${POSITIONAL_NAME} must be snake_case (got: ${member_name})"
    fi
}

# The script must run from the monorepo root.
validate_monorepo_root() {
    if [[ ! -f "$ROOT_PUBSPEC" || ! -d "$BRICKS_DIR" ]]; then
        error_exit "run from the monorepo root (${ROOT_PUBSPEC} + ${BRICKS_DIR}/ required)"
    fi
    if [[ ! -f "$ROOT_MASON" ]]; then
        error_exit "${ROOT_MASON} not found at the monorepo root; no bricks are registered"
    fi
}

# The target subfolder must be allowed and must exist.
validate_target_dir() {
    if (( ! ${ALLOWED_DIRS[(Ie)${target_dir}]} )); then
        usage_exit "'${target_dir}' is not an allowed subfolder (allowed: ${(j:, :)ALLOWED_DIRS})"
    fi
    if [[ ! -d "$target_dir" ]]; then
        error_exit "subfolder /${target_dir} does not exist at the monorepo root"
    fi
}

# Every path brick registered in mason.yaml must exist on disk. Mason resolves
# the whole registry when it runs `mason make`, so ONE stale entry (brick
# folder deleted, registration left behind) fails every brick with
# "Could not find brick at ...". Catch it here with a message naming the
# offenders. Only `path:` bricks are checked; git/hosted bricks are mason's
# business.
validate_registered_bricks() {
    local line
    local name=''
    local brick_path
    local -a missing=()

    while IFS= read -r line; do
        if [[ "$line" =~ '^  ([a-z][a-z0-9_]*):[[:space:]]*$' ]]; then
            name="${match[1]}"
        elif [[ -n "$name" && "$line" =~ '^    path:[[:space:]]*(.+[^[:space:]])[[:space:]]*$' ]]; then
            brick_path="${match[1]}"
            if [[ ! -d "$brick_path" ]]; then
                missing+=("${name} -> ${brick_path}")
            fi
            name=''
        fi
    done < "$ROOT_MASON"

    if (( ${#missing[@]} > 0 )); then
        error_exit "${ROOT_MASON} registers bricks that do not exist on disk; remove the entries or restore the folders, then run 'rm -rf .mason && mason get': ${(j:, :)missing}"
    fi
}

# The requested brick must be registered in mason.yaml AND present under
# /bricks with a brick.yaml. Checking both guards against deleted bricks and
# typos in either place.
validate_brick() {
    if ! grep -q "^  ${brick}:" "$ROOT_MASON"; then
        error_exit "brick '${brick}' is not registered in ${ROOT_MASON}; create it first (see brick_creator)"
    fi
    if [[ ! -d "$(brick_dir)" ]]; then
        error_exit "brick '${brick}' is registered in ${ROOT_MASON} but /$(brick_dir) does not exist (deleted brick or typo in ${ROOT_MASON})"
    fi
    if [[ ! -f "$(brick_yaml)" ]]; then
        error_exit "brick '${brick}' has no ${BRICK_YAML} at /$(brick_yaml)"
    fi
}

# The output folder must not already exist. Generating into an existing
# member is a mistake.
validate_target_path() {
    if [[ -e "$(target_path)" ]]; then
        error_exit "/$(target_path) already exists; pick another ${POSITIONAL_NAME} or remove it first"
    fi
}

# --- brick variables -------------------------------------------------------

# Reads the brick's variable names from brick.yaml into brick_vars.
# Variables are the 2-space-indented keys under the top-level `vars:` block.
read_brick_vars() {
    local line
    local in_vars=false

    while IFS= read -r line; do
        if [[ "$line" =~ '^vars:[[:space:]]*$' ]]; then
            in_vars=true
            continue
        fi
        if [[ "$in_vars" == false ]]; then
            continue
        fi
        # a new top-level key ends the vars block
        if [[ "$line" =~ '^[^[:space:]#]' ]]; then
            break
        fi
        if [[ "$line" =~ '^  ([A-Za-z_][A-Za-z0-9_]*):[[:space:]]*$' ]]; then
            brick_vars+=("${match[1]}")
        fi
    done < "$(brick_yaml)"

    if (( ! ${brick_vars[(Ie)$NAME_VAR]} )); then
        error_exit "brick '${brick}' does not declare the '${NAME_VAR}' variable in ${BRICK_YAML}; ${SCRIPT_NAME} passes ${POSITIONAL_NAME} to it"
    fi
}

# Returns 0 when the brick declares variable $1.
brick_declares() {
    (( ${brick_vars[(Ie)$1]} ))
}

# --- work ------------------------------------------------------------------

run_mason_get() {
    mason get
    info 'mason get complete'
}

# Passes the variables the script knows; mason prompts for the rest.
run_mason_make() {
    local -a mason_vars=("--${NAME_VAR}" "$member_name")
    if brick_declares "$FOLDER_VAR"; then
        mason_vars+=("--${FOLDER_VAR}" "$target_dir")
    fi

    mason make "$brick" "${mason_vars[@]}" -o "$(target_path)"
    success "generated: $(target_path)"
}

# Prints the absolute path to the new member and puts a ready-to-paste
# 'cd <path>' in the clipboard. No trailing newline on the copied text so
# pasting shows the command without executing it.
report_path() {
    local full_path="${PWD}/$(target_path)"

    printf '\n'
    printf '%sPath to %s:%s\n' "${WHITE}" "$member_name" "${RESET}"
    printf '\n'
    printf '  %scd %s%s\n' "${GREEN}" "$full_path" "${RESET}"
    printf '\n'

    if command -v pbcopy > /dev/null 2>&1; then
        printf 'cd %s' "$full_path" | pbcopy
        info 'the cd command is in your clipboard; paste and hit return to jump there'
    else
        warning 'pbcopy not available; copy the cd line above manually'
    fi
}

# -- main ---- where the work is done
main() {
    record_xtrace # record current trace

    enforce_solo_flags "$@"
    handle_about "$@"

    show_banner # banner when the script is started

    # parse/scan the arguments, if any
    local arg
    for arg in "$@"; do
        case "$arg" in
            -h|--help)
                show_help
                exit 0
                ;;
            -a|--about)
                show_about
                exit 0
                ;;
            -x)
                trace_requested=true
                ;;
            --using=*)
                accept_brick "${arg#--using=}"
                ;;
            --dir=*)
                accept_dir "${arg#--dir=}"
                ;;
            --using|--dir)
                usage_exit "${arg} needs a value: ${arg}=<value>"
                ;;
            -*)
                usage_exit "unknown option ${arg}"
                ;;
            *)
                accept_positional "$arg"
                ;;
        esac
    done

    require_positional
    require_options

    if [[ "$trace_requested" == true ]] && ! xtrace_is_on; then
        info 'tracing is on'
        set -x
    fi

    validate_member_name
    validate_monorepo_root
    validate_target_dir
    validate_registered_bricks
    validate_brick
    validate_target_path
    read_brick_vars

    run_mason_get
    run_mason_make
    report_path
}

# Run 'main()' with the parameters, and print a blank line
main "$@"
printf '\n'
