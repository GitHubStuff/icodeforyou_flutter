#!/bin/zsh
# pipe — generate adaptive foreground + monochrome from source icon

## did a 'brew install imagemagick' to get the app, then ran this script and it created the
## the needed icons. - simple '1-of'
set -euo pipefail

readonly _kSrc="assets/iconer.png"
readonly _kForeground="assets/iconer_foreground.png"
readonly _kMonochrome="assets/iconer_monochrome.png"
readonly _kCanvas=1024
readonly _kSafe=683   # ~66% safe zone (72dp of 108dp)

[[ -f "$_kSrc" ]] || { echo "missing $_kSrc" >&2; exit 1 }

magick "$_kSrc" \
  -resize "${_kSafe}x${_kSafe}" \
  -background none -gravity center -extent "${_kCanvas}x${_kCanvas}" \
  "$_kForeground"

magick "$_kSrc" \
  -channel RGB -fill white -colorize 100 \
  -resize "${_kSafe}x${_kSafe}" \
  -background none -gravity center -extent "${_kCanvas}x${_kCanvas}" \
  "$_kMonochrome"

echo "wrote $_kForeground and $_kMonochrome"