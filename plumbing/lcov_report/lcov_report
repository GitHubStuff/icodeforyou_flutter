#!/bin/zsh
# lcov_report - merging every coverage/lcov.info in the icodeforyou_flutter monorepo into one HTML report

readonly VERSION='1.0.0-beta'

readonly TAGLINE='merging member tracefiles into one LCOV HTML report'

# Shows what this script is and does, then exits. Displays when "-a" or
# "--about" is the only parameter (optionally with -x).
show_about() {
    printf '%s' "${CYAN}"
    cat <<'EOF'
lcov_report is the REPORTER half of the monorepo's LCOV pipeline. It takes
the tracefiles that test_coverage left behind and turns them into a single
HTML report for the whole monorepo.

Where this sits in the LCOV chain:

  1. test_coverage          runs each member's tests with coverage on and
                            leaves <member>/coverage/lcov.info behind
  2. lcov_report            finds every coverage/lcov.info in the tree,
     (this script)          combines them, strips machine-written files,
                            renders HTML into /coverage at the root, and
                            opens it in Firefox

The input is whatever coverage/lcov.info files exist. A member that was not
tested, or whose tests failed, has no coverage folder and is simply absent
from the report. This script never runs a test.

What --generate does:

  1. Wipes the root /coverage folder; it holds only this script's output.
  2. Finds every coverage/lcov.info under the monorepo root (the root
     /coverage itself is never an input).
  3. Rewrites each tracefile's SF: paths from lib/... to <member>/lib/...
     so files with the same name in different members cannot collide, and
     so genhtml can find the sources from the root.
  4. Combines them with lcov --add-tracefile into one tracefile.
  5. Strips machine-written files (*.g.dart, *.freezed.dart, *.mocks.dart,
     main.directories.dart, ...) with lcov --remove. Generated code never
     counts toward the coverage number.
  6. Writes the result to /coverage/lcov.info, renders it with genhtml to
     /coverage/html, prints the lcov summary, and opens
     /coverage/html/index.html in Firefox.

Run from the monorepo root. Requires lcov and genhtml on PATH (brew install
lcov) and Firefox for the final step.

Examples:
  % lcov_report --generate
  % lcov_report --generate -x               # traced
  % lcov_report -h                          # help (also --help)
  % lcov_report --about                     # this text (also -a)
EOF
    printf '%s\n' "${RESET}"
}

readonly SCRIPT_NAME="${0:t}"
readonly DEFAULT_BIN_DIR="$HOME/bin"
readonly COLORS_LIB="${DEFAULT_BIN_DIR}/lib/colors.zsh"

# Flags that must be the only parameter on the command line (apart from -x).
readonly -a SOLO_FLAGS=('-a' '--about' '-h' '--help')

# The one flag allowed alongside anything, including a solo flag.
readonly TRACE_FLAG='-x'

# The one work flag.
readonly GENERATE_FLAG='--generate'

# Positional-argument contract. Exactly one of:
#   none     - the script takes no positional argument; giving one is an error
#   optional - the script may take one positional argument
#   required - the script must be given one positional argument
readonly POSITIONAL='none'

# Display name of the positional argument in help and error text.
readonly POSITIONAL_NAME=''

# The monorepo root is identified by its workspace pubspec.
readonly ROOT_PUBSPEC='pubspec.yaml'

# Per-member tracefile location, and the root output folder of the same name.
readonly COVERAGE_DIR='coverage'
readonly LCOV_FILE='lcov.info'

# Outputs, all under the root COVERAGE_DIR.
readonly TEMP_DIR="${COVERAGE_DIR}/tmp"            # rewritten per-member copies
readonly COMBINED_FILE="${COVERAGE_DIR}/combined.info" # before stripping
readonly REPORT_FILE="${COVERAGE_DIR}/${LCOV_FILE}"    # after stripping
readonly HTML_DIR="${COVERAGE_DIR}/html"
readonly HTML_INDEX="${HTML_DIR}/index.html"

# Machine-written files never count toward coverage. lcov --remove patterns,
# matched against the rewritten SF: paths.
readonly -a GENERATED_PATTERNS=(
    '*.g.dart'
    '*.gr.dart'
    '*.gen.dart'
    '*.freezed.dart'
    '*.mocks.dart'
    '*.config.dart'
    '*main.directories.dart'
)

# lcov 2.x error categories that Dart tracefiles legitimately trigger:
#   empty        - function coverage enabled, zero FN records (every Dart file)
#   inconsistent - minor record-count mismatches across merged files
#   format       - tolerant parsing of older tracefile dialects
#   unused       - --remove patterns that match nothing
readonly LCOV_IGNORE='empty,inconsistent,format,unused'
# genhtml 2.x raises its own variants on function-less tracefiles.
readonly GENHTML_IGNORE='source,empty,inconsistent,category'

# Browser the finished report opens in.
readonly BROWSER_APP='Firefox'

# zsh strict mode:
#  -e (errexit) - exit immediately when any command returns non-zero
#  -u (nounset) - treat use of unset variables as an error (typo catcher)
#  -o (pipefail) - pipeline's exit status is the last non-zero status in the pipe,
#      not just the final command's
set -euo pipefail

# Help text with colors, displays when "-h" or "--help" is the only parameter
# (optionally with -x), and on any usage error.
#
# Every option listed here must have a matching branch in main()'s case.
show_help() {
    cat <<EOF
${BOLD}USAGE${RESET}
    ${GREEN}${SCRIPT_NAME}${RESET} ${YELLOW}${GENERATE_FLAG}${RESET} [${YELLOW}-x${RESET}]
    ${GREEN}${SCRIPT_NAME}${RESET} ${YELLOW}-h${RESET}, ${YELLOW}--help${RESET} [${YELLOW}-x${RESET}]
    ${GREEN}${SCRIPT_NAME}${RESET} ${YELLOW}-a${RESET}, ${YELLOW}--about${RESET} [${YELLOW}-x${RESET}]

    No positional arguments. ${GENERATE_FLAG} is required to do any work.
    -h/--help and -a/--about must be used alone; only -x may accompany them.

${BOLD}OPTIONS${RESET}
    ${YELLOW}${GENERATE_FLAG}${RESET}             merge every ${COVERAGE_DIR}/${LCOV_FILE} under the monorepo
                           root into ${WHITE}${REPORT_FILE}${RESET}, render ${WHITE}${HTML_INDEX}${RESET},
                           and open it in ${BROWSER_APP}
    ${YELLOW}-x${RESET}                     turn on command tracing after the arguments are read
                           (may be combined with anything)
    ${YELLOW}-h${RESET}, ${YELLOW}--help${RESET}             show this help, then exit (no other parameters)
    ${YELLOW}-a${RESET}, ${YELLOW}--about${RESET}            show what this script is and does, then exit
                           (no other parameters)

${BOLD}WHAT IT DOES${RESET}
    1. Verifies it is running from the monorepo root (${ROOT_PUBSPEC} with a
       workspace: key) and that lcov and genhtml are on PATH.
    2. Wipes /${COVERAGE_DIR} at the root; it holds only this script's output.
    3. Finds every ${COVERAGE_DIR}/${LCOV_FILE} below the root (hidden folders
       and the root /${COVERAGE_DIR} itself are never inputs). None found is
       an error: run test_coverage first.
    4. Copies each tracefile to ${TEMP_DIR}/ with its SF: paths rewritten
       from lib/... to <member>/lib/..., so same-named files in different
       members cannot collide and genhtml can find the sources.
    5. lcov --add-tracefile (all copies) -> ${COMBINED_FILE}
    6. lcov --remove ${COMBINED_FILE} <generated patterns> -> ${REPORT_FILE}
       patterns: ${GREEN}${(j:, :)GENERATED_PATTERNS}${RESET}
    7. genhtml ${REPORT_FILE} -o ${HTML_DIR}; removes ${TEMP_DIR}/ and
       ${COMBINED_FILE}.
    8. Prints the lcov summary and opens ${HTML_INDEX} in ${BROWSER_APP}.

${BOLD}EXAMPLES${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} ${GENERATE_FLAG}                 ${CYAN}# build and open the report${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} ${GENERATE_FLAG} -x              ${CYAN}# same, traced${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} -a -h                      ${CYAN}# INVALID: solo flags cannot mix${RESET}

EOF
}

# verify color library
if [[ ! -r "$COLORS_LIB" ]]; then
    printf '%s: %s not found, cannot continue\n' "$SCRIPT_NAME" "$COLORS_LIB" >&2
    exit 1
fi
# reads the file and executes its contents in the current shell, rather than
# in a child process, so every function, variable, alias, and setopt defined
# in colors.zsh becomes available in this script's own scope.
source "$COLORS_LIB"

# --- output ----------------------------------------------------------------

show_banner() {
    printf '\n'
    version_print "$SCRIPT_NAME" "$VERSION" "$TAGLINE"
    printf '\n'
}

error_exit() {
    printf '\n'
    error "$1" >&2
    printf '\n'
    exit 1
}

# Any bad input: report it, show help, exit 1.
usage_exit() {
    printf '\n'
    error "$1" >&2
    printf '\n'
    show_help >&2
    exit 1
}

# --- xtrace record / reset -------------------------------------------------
# -x records the current trace state, turns tracing on for the run of the
# script, and at exit resets it to what the parent shell had.
#
# zsh restores the XTRACE option when the function that set it returns, so
# `set -x` must run in the body of the function being traced (main(),
# handle_about()), never in a helper.
XTRACE_WAS_ON=false

xtrace_is_on() {
    [[ -o xtrace ]]
}

record_xtrace() {
    if xtrace_is_on; then
        XTRACE_WAS_ON=true
    fi
}

reset_xtrace() {
    if [[ "$XTRACE_WAS_ON" == false ]] && xtrace_is_on; then
        set +x
        info 'tracing is off'
    fi
}

trap reset_xtrace EXIT

# --- state -----------------------------------------------------------------
# Filled by argument parsing and the tracefile search.

# true when -x was given; tracing is enabled once the arguments are read.
trace_requested=false

# true when --generate was given.
generate_requested=false

# Every member tracefile found, as repo-relative paths.
typeset -a tracefiles=()

# --- argument rules --------------------------------------------------------

# Returns 0 when $1 is one of SOLO_FLAGS.
is_solo_flag() {
    (( ${SOLO_FLAGS[(Ie)$1]} ))
}

# Returns 0 when $1 is the trace flag.
is_trace_flag() {
    [[ "$1" == "$TRACE_FLAG" ]]
}

# Returns 0 when any of the given arguments is the trace flag.
trace_requested_in() {
    (( ${@[(Ie)$TRACE_FLAG]} ))
}

# Enforces the solo-flag rule over the full command line:
#   - at most one of SOLO_FLAGS may appear
#   - when one appears, nothing else may, except TRACE_FLAG
# Any violation is a usage error.
enforce_solo_flags() {
    local arg
    local solo=''
    local -a others=()

    for arg in "$@"; do
        if is_trace_flag "$arg"; then
            continue
        fi
        if is_solo_flag "$arg"; then
            if [[ -n "$solo" ]]; then
                usage_exit "${solo} and ${arg} cannot be combined"
            fi
            solo="$arg"
        else
            others+=("$arg")
        fi
    done

    if [[ -n "$solo" ]] && (( ${#others[@]} > 0 )); then
        usage_exit "${solo} must be the only parameter (apart from ${TRACE_FLAG}), got: ${others[*]}"
    fi
}

# -a / --about is handled before the banner so the output is just the about
# text. enforce_solo_flags() has already guaranteed nothing else is present
# except possibly -x, which is honoured.
handle_about() {
    if (( ${@[(Ie)--about]} || ${@[(Ie)-a]} )); then
        if trace_requested_in "$@" && ! xtrace_is_on; then
            info 'tracing is on'
            set -x
        fi
        show_about
        exit 0
    fi
}

# Rejects a positional argument per the POSITIONAL contract ('none').
accept_positional() {
    local arg="$1"
    if [[ "$POSITIONAL" == 'none' ]]; then
        usage_exit "${SCRIPT_NAME} takes no positional argument, got: ${arg}"
    fi
}

# Accepts --generate. Sets generate_requested.
accept_generate() {
    if [[ "$generate_requested" == true ]]; then
        usage_exit "${GENERATE_FLAG} given twice"
    fi
    generate_requested=true
}

# After parsing: the work flag must be present.
require_work() {
    if [[ "$generate_requested" == false ]]; then
        usage_exit "nothing to do: ${GENERATE_FLAG} is required"
    fi
}

# --- paths -----------------------------------------------------------------

# Member path of a tracefile: strips the trailing /coverage/lcov.info.
member_of() {
    printf '%s' "${1%/${COVERAGE_DIR}/${LCOV_FILE}}"
}

# Temp copy path for a member's rewritten tracefile; slashes become
# underscores so every member maps to one flat file name.
temp_copy_of() {
    printf '%s/%s.info' "$TEMP_DIR" "${1//\//_}"
}

# --- validation ------------------------------------------------------------

# The script must run from the monorepo root.
validate_monorepo_root() {
    if [[ ! -f "$ROOT_PUBSPEC" ]] || ! grep -q '^workspace:' "$ROOT_PUBSPEC"; then
        error_exit "run from the monorepo root (${ROOT_PUBSPEC} with a workspace: key required)"
    fi
}

# lcov and genhtml do the merging and rendering.
validate_tools() {
    local tool
    for tool in lcov genhtml; do
        if ! command -v "$tool" > /dev/null 2>&1; then
            error_exit "${tool} not found on PATH (brew install lcov)"
        fi
    done
}

# --- tracefile discovery ---------------------------------------------------

# Fills tracefiles with every coverage/lcov.info below the root. The glob
# requires at least one folder before coverage/, so the root output folder
# is never an input; hidden folders never match a glob.
find_tracefiles() {
    local tf
    for tf in */**/${COVERAGE_DIR}/${LCOV_FILE}(.N); do
        if [[ -s "$tf" ]]; then
            tracefiles+=("$tf")
        else
            warning "${tf} is empty; skipped"
        fi
    done

    if (( ${#tracefiles[@]} == 0 )); then
        error_exit "no ${COVERAGE_DIR}/${LCOV_FILE} found below the root; run test_coverage first"
    fi
    info "found ${#tracefiles[@]} tracefile(s)"
}

# --- work ------------------------------------------------------------------

# The root coverage folder holds only this script's output.
reset_output() {
    rm -rf "$COVERAGE_DIR"
    mkdir -p "$TEMP_DIR"
}

# Copies each tracefile into TEMP_DIR with SF:lib/ rewritten to
# SF:<member>/lib/. Prints each member as it goes.
rewrite_tracefiles() {
    local tf member
    for tf in "${tracefiles[@]}"; do
        member="$(member_of "$tf")"
        sed "s|^SF:lib/|SF:${member}/lib/|" "$tf" > "$(temp_copy_of "$member")"
        info "  ${member}"
    done
}

# One lcov call folds every rewritten copy into COMBINED_FILE.
combine_tracefiles() {
    local -a add_args=()
    local copy
    for copy in "${TEMP_DIR}"/*.info(.N); do
        add_args+=('--add-tracefile' "$copy")
    done

    lcov --ignore-errors "$LCOV_IGNORE" "${add_args[@]}" --output-file "$COMBINED_FILE"
    info "combined -> ${COMBINED_FILE}"
}

# Machine-written files leave the tracefile here; REPORT_FILE is the result.
strip_generated() {
    lcov --ignore-errors "$LCOV_IGNORE" \
        --remove "$COMBINED_FILE" "${GENERATED_PATTERNS[@]}" \
        --output-file "$REPORT_FILE"
    info "stripped generated files -> ${REPORT_FILE}"
}

render_html() {
    genhtml --ignore-errors "$GENHTML_IGNORE" "$REPORT_FILE" -o "$HTML_DIR"
    if [[ ! -f "$HTML_INDEX" ]]; then
        error_exit "genhtml finished but ${HTML_INDEX} was not created"
    fi
    success "rendered ${HTML_INDEX}"
}

# Intermediates are gone once the report exists.
remove_intermediates() {
    rm -rf "$TEMP_DIR"
    rm -f "$COMBINED_FILE"
}

print_summary() {
    printf '\n'
    lcov --ignore-errors "$LCOV_IGNORE" --summary "$REPORT_FILE"
    printf '\n'
}

open_report() {
    if open -a "$BROWSER_APP" "$HTML_INDEX" 2> /dev/null; then
        info "opened in ${BROWSER_APP}"
    else
        warning "${BROWSER_APP} could not be opened; report is at ${PWD}/${HTML_INDEX}"
    fi
}

generate() {
    find_tracefiles
    reset_output
    rewrite_tracefiles
    combine_tracefiles
    strip_generated
    render_html
    remove_intermediates
    print_summary
    open_report
}

# -- main ---- where the work is done
main() {
    record_xtrace # record current trace

    enforce_solo_flags "$@"
    handle_about "$@"

    show_banner # banner when the script is started

    # parse/scan the arguments, if any
    local arg
    for arg in "$@"; do
        case "$arg" in
            -h|--help)
                show_help
                exit 0
                ;;
            -a|--about)
                show_about
                exit 0
                ;;
            -x)
                trace_requested=true
                ;;
            --generate)
                accept_generate
                ;;
            -*)
                usage_exit "unknown option ${arg}"
                ;;
            *)
                accept_positional "$arg"
                ;;
        esac
    done

    require_work

    if [[ "$trace_requested" == true ]] && ! xtrace_is_on; then
        info 'tracing is on'
        set -x
    fi

    validate_monorepo_root
    validate_tools

    generate
}

# Run 'main()' with the parameters, and print a blank line
main "$@"
printf '\n'
