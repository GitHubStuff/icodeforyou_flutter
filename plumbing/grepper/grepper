#!/bin/zsh
# grepper - File Searching

readonly VERSION='0.0.2'

readonly TAGLINE='File Searching'

# Shows what this script is and does, then exits. Displays when "-a" or
# "--about" is the only parameter (optionally with -x).
#
show_about() {
    printf '%s' "${CYAN}"
    cat <<'EOF'
grepper finds every file under the current folder that contains a string
and writes the list to a markdown report.

It runs a recursive, fixed-string, case-insensitive grep over *.dart and
*.yaml files (or the file patterns you give it), skipping .git, .dart_tool,
build and its own earlier reports, then writes grepper.md (grepper-1.md,
grepper-2.md, ... when one already exists) holding the exact grep command
it ran and the matching paths, one per line, double spaced.

Run it from the folder you want searched; it never looks above it.
Requires grep on PATH.

Examples:
  % grepper "Having fun"                       # search *.dart and *.yaml
  % grepper "Having fun" -include-files='*.md' # search *.md only
  % grepper "Having Fun" -match-case           # case-sensitive
  % grepper -- -foo                            # string starting with -
  % grepper -h                                 # help (also --help)
  % grepper --about                            # this text (also -a)
EOF
    printf '%s\n' "${RESET}"
}

readonly SCRIPT_NAME="${0:t}"
readonly DEFAULT_BIN_DIR="$HOME/bin"
readonly COLORS_LIB="${DEFAULT_BIN_DIR}/lib/colors.zsh"

# Flags that must be the only parameter on the command line (apart from -x).
readonly -a SOLO_FLAGS=('-a' '--about' '-h' '--help')

# The one flag allowed alongside anything, including a solo flag.
readonly TRACE_FLAG='-x'

# Positional-argument contract. Exactly one of:
#   none     - the script takes no positional argument; giving one is an error
#   optional - the script may take one positional argument
#   required - the script must be given one positional argument
readonly POSITIONAL='required'

# Display name of the positional argument in help and error text.
readonly POSITIONAL_NAME='search_string'

# --- grepper constants -----------------------------------------------------

# Everything after this marker is positional, so a search string may start
# with '-' (e.g. grepper -- -foo).
readonly END_OF_FLAGS='--'

# -include-files=<comma list> replaces DEFAULT_INCLUDES; it never merges.
readonly INCLUDE_FLAG='-include-files'
readonly -a DEFAULT_INCLUDES=('*.dart' '*.yaml')

# -match-case turns off the default case-insensitive search.
readonly MATCH_CASE_FLAG='-match-case'

# Always skipped, whatever -include-files= says.
readonly -a EXCLUDE_FILES=('grepper.md' 'grepper-*.md')
readonly -a EXCLUDE_DIRS=('.git' '.dart_tool' 'build')

# The search root. grepper searches where it is run, never above.
readonly SEARCH_ROOT='.'

# Report naming: grepper.md, then grepper-1.md, grepper-2.md, ...
readonly REPORT_STEM='grepper'
readonly REPORT_EXT='.md'

# zsh strick mode:
#  -e (errexit) - exit immediate when any command returns non-zero
#  -u (nounset) - treat use of unset variables as an error (type catcher)
#  -o (pipefail) - pipeline’s exit status is the last non-zero status in the pipe,
#      not just the final command’s
set -euo pipefail

# Help text with colors, displays when "-h" or "--help" is the only parameter
# (optionally with -x), and on any usage error.
# The heredoc is unquoted so ${SCRIPT_NAME}, colors, and any readonly
# constants are interpolated.
#
# Every flag listed here must have a matching branch in main()'s case.
show_help() {
    cat <<EOF
${BOLD}USAGE${RESET}
    ${GREEN}${SCRIPT_NAME}${RESET} ${WHITE}<${POSITIONAL_NAME}>${RESET} [${YELLOW}${INCLUDE_FLAG}=${RESET}${WHITE}<patterns>${RESET}] [${YELLOW}${MATCH_CASE_FLAG}${RESET}] [${YELLOW}-x${RESET}]
    ${GREEN}${SCRIPT_NAME}${RESET} ${YELLOW}${END_OF_FLAGS}${RESET} ${WHITE}<${POSITIONAL_NAME}>${RESET} [${YELLOW}${INCLUDE_FLAG}=${RESET}${WHITE}<patterns>${RESET}] [${YELLOW}${MATCH_CASE_FLAG}${RESET}] [${YELLOW}-x${RESET}]
    ${GREEN}${SCRIPT_NAME}${RESET} ${YELLOW}-h${RESET}, ${YELLOW}--help${RESET} [${YELLOW}-x${RESET}]
    ${GREEN}${SCRIPT_NAME}${RESET} ${YELLOW}-a${RESET}, ${YELLOW}--about${RESET} [${YELLOW}-x${RESET}]

    <${POSITIONAL_NAME}> is the only positional argument (${POSITIONAL}). Flags go in any order.
    -h/--help and -a/--about must be used alone; only -x may accompany them.

${BOLD}ARGUMENTS${RESET}
    ${WHITE}<${POSITIONAL_NAME}>${RESET}      the literal text to look for (not a regex); quote it when
                         it has spaces. Put ${END_OF_FLAGS} before it when it starts with '-'.

${BOLD}FLAGS${RESET}
    ${YELLOW}${INCLUDE_FLAG}=${RESET}${WHITE}<patterns>${RESET}
                         comma-separated file patterns to search, e.g.
                         '*.dart,*.yaml,*.md'. REPLACES the default
                         (${(j:,:)DEFAULT_INCLUDES}); it does not add to it.
    ${YELLOW}${MATCH_CASE_FLAG}${RESET}          match case exactly; default is case-insensitive
    ${YELLOW}${END_OF_FLAGS}${RESET}                   end of flags; the next parameter is <${POSITIONAL_NAME}>
    ${YELLOW}-x${RESET}                   turn on command tracing after the arguments are read
                         (may be combined with anything)
    ${YELLOW}-h${RESET}, ${YELLOW}--help${RESET}           show this help, then exit (no other parameters)
    ${YELLOW}-a${RESET}, ${YELLOW}--about${RESET}          show what this script is and does, then exit
                         (no other parameters)

${BOLD}WHAT IT DOES${RESET}
    runs grep -r -l -F -I (plus -i unless ${MATCH_CASE_FLAG}) from the current folder
    searches only the included file patterns; binaries are ignored
    always skips ${(j:, :)EXCLUDE_DIRS} folders and earlier grepper reports
    refuses to continue if any matched path contains a space
    writes ${REPORT_STEM}${REPORT_EXT} (or ${REPORT_STEM}-1${REPORT_EXT}, -2, ... if taken) holding the
        exact grep command and the matched paths, one per line, double spaced
    prints the report file name; exits 1 when nothing matched

${BOLD}EXAMPLES${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} "Having fun"                       ${CYAN}# *.dart and *.yaml${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} "Having fun" ${INCLUDE_FLAG}='*.md' ${CYAN}# *.md only${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} "Having Fun" ${MATCH_CASE_FLAG}           ${CYAN}# exact case${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} ${END_OF_FLAGS} -foo                            ${CYAN}# search for "-foo"${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} -h                                  ${CYAN}# this help${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} --about -x                          ${CYAN}# what this script is, traced${RESET}
    % ${GREEN}${SCRIPT_NAME}${RESET} -a -h                               ${CYAN}# INVALID: solo flags cannot mix${RESET}

EOF
}

# verify color library
if [[ ! -r "$COLORS_LIB" ]]; then
    printf '%s: %s not found, cannot continue\n' "$SCRIPT_NAME" "$COLORS_LIB" >&2
    exit 1
fi
# reads the file and executes its contents in the current shell, rather than
# in a child process. So every function, variable, alias, and setopt defined
# in colors.zsh becomes available in your script’s own scope — which is the
# whole point of a library file.
source "$COLORS_LIB"

# --- output ----------------------------------------------------------------

show_banner() {
    printf '\n'
    version_print "$SCRIPT_NAME" "$VERSION" "$TAGLINE"
    printf '\n'
}

error_exit() {
    printf '\n'
    error "$1" >&2
    printf '\n'
    exit 1
}

# Any bad input: report it, show help, exit 1.
usage_exit() {
    printf '\n'
    error "$1" >&2
    printf '\n'
    show_help >&2
    exit 1
}

# --- xtrace record / reset -------------------------------------------------
# Having the parameters -x, turns on tracing if NOT already one
# and the end of the script it reset to what it's parent script, if any. was
XTRACE_WAS_ON=false

xtrace_is_on() {
    [[ -o xtrace ]]
}

record_xtrace() {
    if xtrace_is_on; then
        XTRACE_WAS_ON=true
    fi
}

enable_xtrace() {
    if xtrace_is_on; then
        return 0
    fi
    info 'tracing is on'
    set -x
}

reset_xtrace() {
    if [[ "$XTRACE_WAS_ON" == false ]] && xtrace_is_on; then
        set +x
        info 'tracing is off'
    fi
}

trap reset_xtrace EXIT

# --- state -----------------------------------------------------------------
# Filled by argument parsing.

# true when -x was given; tracing is enabled once the arguments are read.
trace_requested=false

# The positional argument, empty when none was given.
search_string=''

# true once END_OF_FLAGS has been seen; every later argument is positional.
flags_ended=false

# true when -match-case was given.
match_case=false

# true once -include-files= has been given (it may be given only once).
includes_given=false

# The file patterns to search; DEFAULT_INCLUDES unless -include-files= is set.
include_patterns=("${DEFAULT_INCLUDES[@]}")

# Filled by the search.

# The grep switches (-r -l -F -I [-i]) and the --include/--exclude options,
# kept apart so the report can lay them out one per line.
grep_switches=()
grep_filters=()

# The matched paths, one per element; empty when nothing matched.
matched_paths=()

# --- argument rules --------------------------------------------------------

# Returns 0 when $1 is one of SOLO_FLAGS.
is_solo_flag() {
    (( ${SOLO_FLAGS[(Ie)$1]} ))
}

# Returns 0 when $1 is the trace flag.
is_trace_flag() {
    [[ "$1" == "$TRACE_FLAG" ]]
}

# Returns 0 when any of the given arguments is the trace flag.
trace_requested_in() {
    (( ${@[(Ie)$TRACE_FLAG]} ))
}

# Enforces the solo-flag rule over the full command line:
#   - at most one of SOLO_FLAGS may appear
#   - when one appears, nothing else may, except TRACE_FLAG
# Any violation is a usage error.
enforce_solo_flags() {
    local arg
    local solo=''
    local -a others=()

    for arg in "$@"; do
        if is_trace_flag "$arg"; then
            continue
        fi
        if is_solo_flag "$arg"; then
            if [[ -n "$solo" ]]; then
                usage_exit "${solo} and ${arg} cannot be combined"
            fi
            solo="$arg"
        else
            others+=("$arg")
        fi
    done

    if [[ -n "$solo" ]] && (( ${#others[@]} > 0 )); then
        usage_exit "${solo} must be the only parameter (apart from ${TRACE_FLAG}), got: ${others[*]}"
    fi
}

# -a / --about is handled before the banner so the output is just the about
# text. enforce_solo_flags() has already guaranteed nothing else is present
# except possibly -x, which is honoured.
handle_about() {
    if (( ${@[(Ie)--about]} || ${@[(Ie)-a]} )); then
        if trace_requested_in "$@"; then
            enable_xtrace
        fi
        show_about
        exit 0
    fi
}

# Accepts one positional argument per the POSITIONAL contract.
# Sets search_string.
accept_positional() {
    local arg="$1"
    if [[ "$POSITIONAL" == 'none' ]]; then
        usage_exit "${SCRIPT_NAME} takes no positional argument, got: ${arg}"
    fi
    if [[ -n "$search_string" ]]; then
        usage_exit "one ${POSITIONAL_NAME} at a time, got ${search_string} and ${arg}"
    fi
    search_string="$arg"
}

# After parsing: fails when the contract is 'required' and none was given.
require_positional() {
    if [[ "$POSITIONAL" == 'required' && -z "$search_string" ]]; then
        usage_exit "${POSITIONAL_NAME} is required"
    fi
}

# Accepts the value of -include-files=<patterns>. The value must be a
# comma-separated list with no empty entries. Replaces include_patterns.
accept_include_files() {
    local value="$1"

    if [[ "$includes_given" == true ]]; then
        usage_exit "${INCLUDE_FLAG}= may be given only once"
    fi
    if [[ -z "$value" ]]; then
        usage_exit "${INCLUDE_FLAG}= needs at least one pattern, e.g. ${INCLUDE_FLAG}='*.md'"
    fi
    if [[ "$value" == ,* || "$value" == *, || "$value" == *,,* ]]; then
        usage_exit "${INCLUDE_FLAG}= has an empty entry: '${value}'"
    fi

    include_patterns=("${(@s:,:)value}")
    includes_given=true
}

# --- search ----------------------------------------------------------------

# Fills grep_switches and grep_filters from the parsed state.
compose_grep_arguments() {
    local pattern
    local dir

    grep_switches=('-r' '-l' '-F' '-I')
    if [[ "$match_case" == false ]]; then
        grep_switches+=('-i')
    fi

    grep_filters=()
    for pattern in "${include_patterns[@]}"; do
        grep_filters+=("--include=${pattern}")
    done
    for pattern in "${EXCLUDE_FILES[@]}"; do
        grep_filters+=("--exclude=${pattern}")
    done
    for dir in "${EXCLUDE_DIRS[@]}"; do
        grep_filters+=("--exclude-dir=${dir}")
    done
}

# Runs grep and fills matched_paths. grep exits 0 on matches, 1 on none,
# anything else is a failure.
run_grep() {
    local output=''
    local grep_status=0

    output="$(grep "${grep_switches[@]}" "${grep_filters[@]}" \
        -e "$search_string" "$SEARCH_ROOT")" || grep_status=$?

    case "$grep_status" in
        0|1) ;;
        *) error_exit "grep failed with exit status ${grep_status}" ;;
    esac

    if [[ -z "$output" ]]; then
        matched_paths=()
    else
        matched_paths=("${(@f)output}")
    fi
}

# Refuses any matched path containing a space: the report must be
# copy/paste safe, line by line.
reject_paths_with_spaces() {
    local path
    for path in "${matched_paths[@]}"; do
        if [[ "$path" == *' '* ]]; then
            error_exit "matched path contains a space: ${path}"
        fi
    done
}

# --- report ----------------------------------------------------------------

# Prints the first free report name: grepper.md, grepper-1.md, grepper-2.md...
next_report_name() {
    local name="${REPORT_STEM}${REPORT_EXT}"
    local n=0

    while [[ -e "$name" ]]; do
        n=$(( n + 1 ))
        name="${REPORT_STEM}-${n}${REPORT_EXT}"
    done
    printf '%s\n' "$name"
}

# Prints the grep command that was run, one option per line with
# continuation backslashes, values double-quoted, ready to paste.
print_grep_command() {
    local filter

    printf 'grep %s \\\n' "${grep_switches[*]}"
    for filter in "${grep_filters[@]}"; do
        printf '  %s="%s" \\\n' "${filter%%=*}" "${filter#*=}"
    done
    printf '  -e "%s" %s\n' "$search_string" "$SEARCH_ROOT"
}

# Prints the matched paths, double spaced, or "none".
print_matches() {
    local path

    if (( ${#matched_paths[@]} == 0 )); then
        printf 'none\n'
        return 0
    fi
    for path in "${matched_paths[@]}"; do
        printf '%s\n\n' "$path"
    done
}

# Writes the whole report to $1.
write_report() {
    local report="$1"
    {
        printf '# grepper report for "%s"\n\n' "$search_string"
        printf '## Command\n\n'
        print_grep_command
        printf '\n## matches\n\n'
        print_matches
    } > "$report"
}

# -- main ---- where the work is done
main() {
    record_xtrace # record current trace

    enforce_solo_flags "$@"
    handle_about "$@"

    show_banner # banner when the script is started

    # parse/scan the arguments, if any
    local arg
    for arg in "$@"; do
        if [[ "$flags_ended" == true ]]; then
            accept_positional "$arg"
            continue
        fi
        case "$arg" in
            -h|--help)
                show_help
                exit 0
                ;;
            -a|--about)
                show_about
                exit 0
                ;;
            -x)
                trace_requested=true
                ;;
            "$END_OF_FLAGS")
                flags_ended=true
                ;;
            "${INCLUDE_FLAG}"=*)
                accept_include_files "${arg#*=}"
                ;;
            "$INCLUDE_FLAG")
                usage_exit "${INCLUDE_FLAG} needs =<patterns>, e.g. ${INCLUDE_FLAG}='*.md'"
                ;;
            "$MATCH_CASE_FLAG")
                match_case=true
                ;;
            #  -*) — matches any string beginning with -. Placed after the
            #      known flags, it catches typos and unsupported options so they don’t
            #      silently fall through and get treated as a file name.
            #   *) — matches everything. It’s the default/else branch,
            #      so it must be last.

            # Order matters: if *) came first, nothing below it would ever run.
            -*)
                usage_exit "unknown option ${arg}"
                ;;
            *)
                accept_positional "$arg"
                ;;
        esac
    done

    require_positional

    if [[ "$trace_requested" == true ]]; then
        enable_xtrace
    fi

    local report
    compose_grep_arguments
    run_grep
    reject_paths_with_spaces
    report="$(next_report_name)"
    write_report "$report"
    printf '%s\n' "$report"

    if (( ${#matched_paths[@]} == 0 )); then
        exit 1
    fi
}

# Run 'main()' with the parameters, and print a blank line
main "$@"
printf '\n'
