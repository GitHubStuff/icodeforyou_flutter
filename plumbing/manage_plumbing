#!/bin/zsh
# manage_plumbing - Make a plumbing script executable, make double-click
#                   open it in an editor, and optionally copy it into a
#                   bin directory.

readonly VERSION='0.1.2'

set -euo pipefail

show_help() {
    cat <<EOF
${BOLD}USAGE${RESET}
    ${GREEN}${SCRIPT_NAME}${RESET} ${WHITE}<plumbing>${RESET} [${YELLOW}-c${RESET} | ${YELLOW}--copy=${RESET}${WHITE}<directory>${RESET}] [${YELLOW}-b=${RESET}${WHITE}<id>${RESET} | ${YELLOW}--bundle_id=${RESET}${WHITE}<id>${RESET}] [${YELLOW}-x${RESET}]
    ${GREEN}${SCRIPT_NAME}${RESET} ${YELLOW}-h${RESET}, ${YELLOW}--help${RESET}

    <plumbing> is the only positional argument. Flags go in any order.
    Without ${YELLOW}-c${RESET} or ${YELLOW}--copy=${RESET} nothing is copied.

${BOLD}FLAGS${RESET}
    ${YELLOW}-c${RESET}                   copy into ${CYAN}${DEFAULT_BIN_DIR}${RESET}
    ${YELLOW}--copy=${RESET}${WHITE}<directory>${RESET}   copy into <directory> instead
                         (${YELLOW}-c${RESET} and ${YELLOW}--copy=${RESET} cannot be combined)
    ${YELLOW}-b=${RESET}${WHITE}<id>${RESET}              editor to open the script with, default ${CYAN}${DEFAULT_BUNDLE_ID}${RESET}
    ${YELLOW}--bundle_id=${RESET}${WHITE}<id>${RESET}     same as ${YELLOW}-b=${RESET} (the two cannot be combined)
                         <id> may only contain letters, digits, hyphens and periods
    ${YELLOW}-x${RESET}                   turn on command tracing after the arguments are read

${BOLD}WHAT IT DOES${RESET}
    makes <plumbing> executable
    sets TextEdit as its "Open With" app, so double-click opens an editor
    with ${YELLOW}-c${RESET} or ${YELLOW}--copy=${RESET}: copies it into the bin directory, overwriting any
        existing copy, and makes the copy executable with the same "Open With"
    sets the chosen editor as the "Open With" app on every file it touched

${BOLD}IF THE EDITOR IS NOT INSTALLED${RESET}
    everything above still happens except the last step; the files
    open with TextEdit, and the exit status is 1

EOF
}

readonly SCRIPT_NAME="${0:t}"
readonly DEFAULT_BIN_DIR="$HOME/bin"
readonly COLORS_LIB="${DEFAULT_BIN_DIR}/lib/colors.zsh"
readonly DEFAULT_BUNDLE_ID='com.barebones.bbedit'
readonly BUNDLE_ID_PATTERN='^[A-Za-z0-9.-]+$'
readonly OPEN_WITH_XATTR='com.apple.LaunchServices.OpenWith'
readonly TAGLINE='creating zsh scripts'
readonly TEXT_EDIT_BUNDLE_ID='com.apple.TextEdit'

if [[ ! -r "$COLORS_LIB" ]]; then
    printf '%s: %s not found, cannot continue\n' "$SCRIPT_NAME" "$COLORS_LIB" >&2
    exit 1
fi
# reads the file and executes its contents in the current shell, rather than 
# in a child process. So every function, variable, alias, and setopt defined
# in colors.zsh becomes available in your script’s own scope — which is the
# whole point of a library file.
source "$COLORS_LIB"

# --- output ----------------------------------------------------------------

show_banner() {
    printf '\n'
    color_print "${BOLD}${CYAN}" "${SCRIPT_NAME} version ${VERSION}, ${TAGLINE}"
    printf '\n'
}

error_exit() {
    printf '\n'
    error "$1" >&2
    printf '\n'
    exit 1
}

# --- xtrace record / reset -------------------------------------------------

XTRACE_WAS_ON=false

xtrace_is_on() {
    [[ -o xtrace ]]
}

record_xtrace() {
    if xtrace_is_on; then
        XTRACE_WAS_ON=true
    fi
}

enable_xtrace() {
    if xtrace_is_on; then
        return 0
    fi
    info 'tracing is on'
    set -x
}

reset_xtrace() {
    if [[ "$XTRACE_WAS_ON" == false ]] && xtrace_is_on; then
        set +x
        info 'tracing is off'
    fi
}

trap reset_xtrace EXIT

# --- bundle lookup ---------------------------------------------------------

# Apple allows only letters, digits, hyphens and periods in a bundle id.
require_valid_bundle_id() {
    local bundle_id="$1"
    [[ "$bundle_id" =~ $BUNDLE_ID_PATTERN ]] \
        || error_exit "${bundle_id} is not a valid bundle id (letters, digits, hyphens and periods only)"
}

# Prints the .app path for a bundle id, or nothing if it is not installed.
find_app_for_bundle() {
    local bundle_id="$1"
    mdfind "kMDItemCFBundleIdentifier == '${bundle_id}'" 2>/dev/null | head -n 1
}

app_display_name() {
    local app_path="$1"
    print -- "${app_path:t:r}"
}

set_open_with() {
    local target="$1"
    local bundle_id="$2"
    local app_path="$3"
    local plist_hex

    plist_hex="$(
        cat <<EOF | plutil -convert binary1 -o - - | xxd -p | tr -d '\n'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>path</key>
    <string>${app_path}</string>
    <key>bundleidentifier</key>
    <string>${bundle_id}</string>
    <key>version</key>
    <string>0</string>
</dict>
</plist>
EOF
    )"

    xattr -wx "$OPEN_WITH_XATTR" "$plist_hex" "$target"
}

# --- file operations -------------------------------------------------------

make_executable() {
    local target="$1"
    chmod +x "$target"
}

ensure_directory() {
    local directory="$1"
    if [[ ! -d "$directory" ]]; then
        mkdir -p "$directory" || error_exit "cannot create ${directory}"
    fi
    [[ -w "$directory" ]] || error_exit "${directory} is not writable"
}

copy_into() {
    local source_file="$1"
    local directory="$2"
    local destination="${directory}/${source_file:t}"
    cp -pf "$source_file" "$destination" || error_exit "copy to ${destination} failed"
    print -- "$destination"
}

# --- main ------------------------------------------------------------------

main() {
    local plumbing=''
    local bin_dir=''
    local bundle_id=''
    local trace_requested=false

    record_xtrace
    show_banner

    [[ $# -eq 0 ]] && { show_help >&2; exit 1; }

    local arg
    for arg in "$@"; do
        case "$arg" in
            -h|--help)
                show_help
                exit 0
                ;;
            -x)
                trace_requested=true
                ;;
            -c)
                [[ -n "$bin_dir" ]] && error_exit '-c and --copy= cannot be combined'
                bin_dir="$DEFAULT_BIN_DIR"
                ;;
            --copy=*)
                [[ -n "$bin_dir" ]] && error_exit '-c and --copy= cannot be combined'
                bin_dir="${arg#--copy=}"
                [[ -z "$bin_dir" ]] && error_exit '--copy= needs a directory'
                ;;
            -b=*)
                [[ -n "$bundle_id" ]] && error_exit '-b= and --bundle_id= cannot be combined'
                bundle_id="${arg#-b=}"
                [[ -z "$bundle_id" ]] && error_exit '-b= needs a bundle id'
                ;;
            --bundle_id=*)
                [[ -n "$bundle_id" ]] && error_exit '-b= and --bundle_id= cannot be combined'
                bundle_id="${arg#--bundle_id=}"
                [[ -z "$bundle_id" ]] && error_exit '--bundle_id= needs a bundle id'
                ;;
            -*)
                error_exit "unknown option ${arg}"
                ;;
            *)
                [[ -n "$plumbing" ]] && error_exit "one plumbing file at a time, got ${plumbing} and ${arg}"
                plumbing="$arg"
                ;;
        esac
    done

    [[ -z "$bundle_id" ]] && bundle_id="$DEFAULT_BUNDLE_ID"
    require_valid_bundle_id "$bundle_id"

    [[ "$trace_requested" == true ]] && enable_xtrace

    [[ -z "$plumbing" ]] && error_exit 'no plumbing file given'
    [[ -f "$plumbing" ]] || error_exit "${plumbing} is not a file"

    local text_edit_path
    text_edit_path="$(find_app_for_bundle "$TEXT_EDIT_BUNDLE_ID")"
    [[ -z "$text_edit_path" ]] && error_exit 'TextEdit is not installed, cannot continue'

    local app_path
    app_path="$(find_app_for_bundle "$bundle_id")"

    local name="${plumbing:t}"
    local -a targets
    targets=("$plumbing")

    make_executable "$plumbing"
    set_open_with "$plumbing" "$TEXT_EDIT_BUNDLE_ID" "$text_edit_path"
    success "${name} is now executable"

    if [[ -n "$bin_dir" ]]; then
        ensure_directory "$bin_dir"
        local copied_file
        copied_file="$(copy_into "$plumbing" "$bin_dir" | tail -n 1)"
        make_executable "$copied_file"
        set_open_with "$copied_file" "$TEXT_EDIT_BUNDLE_ID" "$text_edit_path"
        targets+=("$copied_file")
        success "${name} has been copied to ${bin_dir}"
    fi

    if [[ -z "$app_path" ]]; then
        warning "${name} opens with $(app_display_name "$text_edit_path")"
        error_exit "bundle_id ${bundle_id} is not installed"
    fi

    local target
    for target in "${targets[@]}"; do
        set_open_with "$target" "$bundle_id" "$app_path"
    done
    success "${name} opens with $(app_display_name "$app_path")"
}

main "$@"
printf '\n'
